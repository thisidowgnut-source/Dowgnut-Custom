# DOHNUT — environment template
# Copy to .env and fill in your own values. NEVER commit the real .env.

# Local SQLite database (regenerates + auto-seeds on first run)
DATABASE_URL="file:./db/custom.db"

# Admin dashboard key — generate a strong random string for production
ADMIN_API_KEY="change-me-strong-random-key"

# AI Concierge / AI Designer (Z.ai SDK)
# ZAI_API_KEY is injected automatically in the sandbox; set it for other hosts
# ZAI_API_KEY=""
# ZAI_BASE_URL=""

# Billplz payments (leave empty in dev to use the auto-paid fallback)
BILLPLZ_API_KEY=""
BILLPLZ_COLLECTION_ID=""
BILLPLZ_X_SIGNATURE_KEY=""
BILLPLZ_SANDBOX="true"
NEXT_PUBLIC_BASE_URL=""

# Dev-only escape hatch: set to "true" ONLY for local/offline demos where you
# want checkout to auto-mark orders as paid without Billplz credentials.
# Keep "false" in production — a production deploy without credentials must
# fail loudly (503) instead of handing out free donuts.
PAYMENTS_ALLOW_DEV_FALLBACK="false"
